# Copy this file to .env and fill in the empty values. Never commit .env.

# --- Application -------------------------------------------------------------
APP_NAME=Torsade
# local, testing or production
APP_ENV=local
# Generated by `php artisan key:generate`
APP_KEY=
# Must be false in production: debug pages expose configuration values
APP_DEBUG=true
# Public URL of the application, without a trailing slash
APP_URL=http://torsade.test

# Interface language, and the language used when a translation is missing
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Dates are always stored in UTC. This is the timezone used to display them.
APP_DISPLAY_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file

# Cost factor of password hashing
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MariaDB only) -------------------------------------------------
# The test suite uses the same server and credentials with the database
# "torsade_test", declared in phpunit.xml.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torsade
DB_USERNAME=
DB_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# Sessions live in the database so that an administrator can revoke them.
SESSION_DRIVER=database
# Minutes of inactivity before a session expires
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is always HttpOnly and SameSite=Lax. In production it
# is Secure and its name is prefixed with __Host-, so the browser only
# accepts it with Path=/, no Domain and Secure: never set
# SESSION_SECURE_COOKIE to false there, or no one could sign in. Elsewhere
# it is Secure on HTTPS requests only.
# SESSION_SECURE_COOKIE=true
# SESSION_COOKIE=__Host-torsade-session

# --- Security headers --------------------------------------------------------
# HTTP Strict Transport Security: tells the browser to come back only in
# HTTPS. Turned on by the installer when a certificate of a known authority
# is provided and the HSTS option is given. Never with a self-signed one.
HSTS_ENABLED=false
# Comma-separated hosts, besides the one of APP_URL, allowed as Host header
# in production. Empty when the application is only reached through APP_URL.
TRUSTED_HOSTS=
# Comma-separated proxy addresses or CIDR prefixes trusted to carry the
# real client address and scheme. Empty by default: the X-Forwarded-*
# headers are then ignored.
TRUSTED_PROXIES=

# --- Cache, queue and files --------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail --------------------------------------------------------------------
# Torsade sends no e-mail: anything mailed is only written to the log.
MAIL_MAILER=log

# --- Front-end ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
